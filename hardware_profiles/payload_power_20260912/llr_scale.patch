+++ b/ip_repo/openofdm_rx/src/demodulate.v
@@ -14,1 +14,2 @@
     input soft_bits_method,
+    input [2:0] payload_power_shift,
@@ -244,1 +245,16 @@
-assign raw_llr_i_mult_csi_square_over_noise_var_reduce[0] = $signed(raw_llr_i_mult_csi_square_over_noise_var[0][(16+12+34):16]);
+// Align the per-sample tag with constellation delay, raw LLR, and CSI product.
+// RX restores y/a; its noise variance is N0/a^2, so the BPSK LLR must be
+// multiplied by a^2 before soft quantization. Only legacy BPSK carries a tag.
+reg [2:0] power_shift_d1, power_shift_d2, power_shift_d3;
+always @(posedge clock) begin
+    if (reset) begin
+        power_shift_d1 <= 0;
+        power_shift_d2 <= 0;
+        power_shift_d3 <= 0;
+    end else if (enable) begin
+        power_shift_d1 <= payload_power_shift;
+        power_shift_d2 <= power_shift_d1;
+        power_shift_d3 <= power_shift_d2;
+    end
+end
+assign raw_llr_i_mult_csi_square_over_noise_var_reduce[0] = $signed(raw_llr_i_mult_csi_square_over_noise_var[0][(16+12+34):16]) >>> {power_shift_d3, 1'b0};
